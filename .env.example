# Publiczne wartości Supabase — ustaw je lokalnie oraz w Netlify przed wdrożeniem.
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Opcjonalnie: false włącza prawdziwe logowanie także na localhost w npm run dev.
# Podgląd bez logowania działa domyślnie tylko w trybie DEV na adresie loopback.
# W buildzie produkcyjnym podgląd jest zawsze wyłączony.
PUBLIC_LOCAL_PREVIEW=true
# Publiczny kontakt do dokumentacji aplikacji Allegro, podany przez właściciela.
PUBLIC_ALLEGRO_CONTACT_EMAIL=

# Tylko serwer / Netlify Functions. Nie używaj prefiksu PUBLIC_ dla danych Allegro.
ALLEGRO_CLIENT_ID=
ALLEGRO_CLIENT_SECRET=
# Dokładna wartość z https://apps.developer.allegro.pl/user-agent (bez nazwy nagłówka).
ALLEGRO_USER_AGENT=
# Stały klucz: 32 losowe bajty w Base64. Nie zmieniaj go po połączeniu kont.
ALLEGRO_TOKEN_ENCRYPTION_KEY=
