---
import Icon from './Icon.astro';
---
<dialog id="wordpress-setup" class="wordpress-setup" aria-labelledby="wordpress-setup-title">
  <div class="section-heading"><div><span class="eyebrow">AKTYWNA INTEGRACJA</span><h2 id="wordpress-setup-title">Połącz WooCommerce</h2></div><span class="integration-state" data-state>Nie skonfigurowano</span></div>
  <p class="setup-intro">Ten formularz tworzy bezpieczne dane dostępowe dla zainstalowanej wtyczki Sellio Connector. Dane połączenia są zapisywane na serwerze i przypisane do Twojego konta.</p>
  <form class="integration-form" data-connect-form>
    <label>Adres backendu<input name="backend_url" type="url" value="https://allsellio.netlify.app" required /></label>
    <label>Nazwa sklepu<input name="name" placeholder="Mój sklep WooCommerce" required /></label>
    <label>Adres sklepu WordPress<input name="site_url" type="url" placeholder="https://sklep.example.pl" required /></label>
    <div class="catalog-details"><strong>Dostęp do katalogu produktów</strong><p>Wygeneruj token katalogu we wtyczce WordPress, a następnie wklej go tutaj. Dzięki temu Sellio może pobrać produkty i warianty.</p><label>Token katalogu<input name="catalog_token" type="password" autocomplete="off" required /></label></div>
    <button class="button button-primary" type="submit"><Icon name="plug" size={16} />Utwórz połączenie</button>
  </form>
  <div class="credentials-box" data-credentials hidden>
    <div><span class="eyebrow">DANE DO WKLEJENIA WE WTYCZCE</span><h3>Połączenie jest gotowe</h3><p>W WordPress: WooCommerce → Sellio Connector wklej poniższe trzy wartości, zapisz ustawienia i wybierz „Sprawdź połączenie”.</p></div>
    <dl><div><dt>API Sellio</dt><dd data-api-url></dd></div><div><dt>ID sklepu</dt><dd data-store-id></dd></div><div><dt>Token API</dt><dd data-api-token></dd></div></dl>
    <button class="button" type="button" data-copy>Skopiuj dane</button>
  </div>
  <p class="integration-feedback" role="status" data-feedback></p>
</dialog>
<script>
  import { authenticatedFetch } from "../lib/auth";
  import { loadWordpressStore } from "../lib/wordpress";
  const form = document.querySelector<HTMLFormElement>('[data-connect-form]')!;
  const feedback = document.querySelector<HTMLElement>('[data-feedback]')!;
  const credentials = document.querySelector<HTMLElement>('[data-credentials]')!;
  const state = document.querySelector<HTMLElement>('[data-state]')!;
  const value = (name: string) => (new FormData(form).get(name) as string).trim();
  const backend = () => value('backend_url').replace(/\/$/, '');
  const dialog = document.querySelector<HTMLDialogElement>('#wordpress-setup')!;
  const closeButton = document.createElement('button'); closeButton.type = 'button'; closeButton.className = 'integration-dialog-close'; closeButton.setAttribute('aria-label', 'Zamknij konfigurację'); closeButton.textContent = '×'; closeButton.addEventListener('click', () => dialog.close()); dialog.prepend(closeButton);
  form.addEventListener('submit', async event => {
    event.preventDefault(); credentials.hidden = true; feedback.textContent = 'Tworzę połączenie…';
    try {
      const response = await authenticatedFetch(`${backend()}/v1/admin/wordpress/stores`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ name: value('name'), site_url: value('site_url'), catalog_url: value('site_url'), catalog_token: value('catalog_token') }) });
      const data = await response.json(); if (!response.ok) throw new Error(data.error || 'Nie udało się utworzyć połączenia.');
      document.querySelector<HTMLElement>('[data-api-url]')!.textContent = backend();
      document.querySelector<HTMLElement>('[data-store-id]')!.textContent = data.store_id;
      document.querySelector<HTMLElement>('[data-api-token]')!.textContent = data.api_token;
      credentials.hidden = false; state.textContent = 'Oczekuje na weryfikację w WordPress'; state.classList.add('pending');
      const catalogToken = value('catalog_token');
      const importResponse = await authenticatedFetch(`${backend()}/v1/admin/wordpress/stores/${data.store_id}/catalog/import`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ catalog_url: value('site_url'), catalog_token: catalogToken, mode: 'full' }) });
      const imported = await importResponse.json(); if (!importResponse.ok) throw new Error(imported.error || 'Nie udało się zaimportować katalogu WordPress.');
      feedback.textContent = `Dane dostępowe utworzone i zaimportowano ${imported.imported} produktów. Token API jest widoczny tylko teraz — skopiuj go przed zamknięciem strony.`;
    } catch (error) { feedback.textContent = error instanceof Error ? error.message : 'Wystąpił nieznany błąd.'; state.textContent = 'Błąd konfiguracji'; state.classList.add('error'); }
  });
  document.querySelector<HTMLButtonElement>('[data-copy]')!.addEventListener('click', async () => {
    const api = document.querySelector<HTMLElement>('[data-api-url]')!.textContent; const id = document.querySelector<HTMLElement>('[data-store-id]')!.textContent; const token = document.querySelector<HTMLElement>('[data-api-token]')!.textContent;
    await navigator.clipboard.writeText(`API Sellio: ${api}\nID sklepu: ${id}\nToken API: ${token}`); feedback.textContent = 'Dane skopiowane do schowka.';
  });
  loadWordpressStore().then(store => {
    if (!store) return;
    for (const [name, value] of Object.entries({ name: store.name, site_url: store.site_url, backend_url: store.credentials.backend_url })) {
      (form.elements.namedItem(name) as HTMLInputElement).value = value || '';
    }
    state.textContent = `Skonfigurowano: ${store.name}`;
  }).catch(error => { feedback.textContent = error instanceof Error ? error.message : 'Nie udało się odczytać integracji.'; });
</script>
