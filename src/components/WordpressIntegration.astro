---
import Icon from './Icon.astro';
---
<dialog id="wordpress-setup" class="wordpress-setup" aria-labelledby="wordpress-setup-title">
  <div class="section-heading"><div><span class="eyebrow">AKTYWNA INTEGRACJA</span><h2 id="wordpress-setup-title">Połącz WooCommerce</h2></div><span class="integration-state" data-state>Nie skonfigurowano</span></div>
  <p class="setup-intro">Ten formularz tworzy bezpieczne dane dostępowe dla zainstalowanej wtyczki Sellio Connector. Klucz administratora pozostaje tylko w tej sesji przeglądarki.</p>
  <form class="integration-form" data-connect-form>
    <label>Adres backendu<input name="backend_url" type="url" value="https://allsellio.netlify.app" required /></label>
    <label>Nazwa sklepu<input name="name" placeholder="Mój sklep WooCommerce" required /></label>
    <label>Adres sklepu WordPress<input name="site_url" type="url" placeholder="https://sklep.example.pl" required /></label>
    <details class="catalog-details"><summary>Opcjonalnie: dostęp do katalogu produktów</summary><p>Najpierw wygeneruj token katalogu we wtyczce WordPress, a potem wklej go tutaj. Dzięki temu Sellio może pobrać produkty i warianty.</p><label>Token katalogu<input name="catalog_token" type="password" autocomplete="off" /></label></details>
    <button class="button button-primary" type="submit"><Icon name="plug" size={16} />Utwórz połączenie</button>
  </form>
  <div class="credentials-box" data-credentials hidden>
    <div><span class="eyebrow">DANE DO WKLEJENIA WE WTYCZCE</span><h3>Połączenie jest gotowe</h3><p>W WordPress: WooCommerce → Sellio Connector wklej poniższe trzy wartości, zapisz ustawienia i wybierz „Sprawdź połączenie”.</p></div>
    <dl><div><dt>API Sellio</dt><dd data-api-url></dd></div><div><dt>ID sklepu</dt><dd data-store-id></dd></div><div><dt>Token API</dt><dd data-api-token></dd></div></dl>
    <button class="button" type="button" data-copy>Skopiuj dane</button>
  </div>
  <p class="integration-feedback" role="status" data-feedback></p>
</dialog>
<script>
  const form = document.querySelector<HTMLFormElement>('[data-connect-form]')!;
  const feedback = document.querySelector<HTMLElement>('[data-feedback]')!;
  const credentials = document.querySelector<HTMLElement>('[data-credentials]')!;
  const state = document.querySelector<HTMLElement>('[data-state]')!;
  const value = (name: string) => (new FormData(form).get(name) as string).trim();
  const backend = () => value('backend_url').replace(/\/$/, '');
  const authorization = () => {
    const session = JSON.parse(localStorage.getItem('sellio-auth-session') || 'null');
    if (!session?.access_token) throw new Error('Zaloguj się ponownie, aby skonfigurować integrację.');
    return { Authorization: `Bearer ${session.access_token}` };
  };
  const dialog = document.querySelector<HTMLDialogElement>('#wordpress-setup')!;
  const closeButton = document.createElement('button'); closeButton.type = 'button'; closeButton.className = 'integration-dialog-close'; closeButton.setAttribute('aria-label', 'Zamknij konfigurację'); closeButton.textContent = '×'; closeButton.addEventListener('click', () => dialog.close()); dialog.prepend(closeButton);
  form.addEventListener('submit', async event => {
    event.preventDefault(); credentials.hidden = true; feedback.textContent = 'Tworzę połączenie…';
    try {
      const response = await fetch(`${backend()}/v1/admin/wordpress/stores`, { method: 'POST', headers: { 'Content-Type': 'application/json', ...authorization() }, body: JSON.stringify({ name: value('name'), site_url: value('site_url'), catalog_url: value('site_url'), catalog_token: value('catalog_token') }) });
      const data = await response.json(); if (!response.ok) throw new Error(data.error || 'Nie udało się utworzyć połączenia.');
      localStorage.setItem('sellio-product-view', JSON.stringify({ backend_url: backend(), store_id: data.store_id }));
      document.querySelector<HTMLElement>('[data-api-url]')!.textContent = backend();
      document.querySelector<HTMLElement>('[data-store-id]')!.textContent = data.store_id;
      document.querySelector<HTMLElement>('[data-api-token]')!.textContent = data.api_token;
      credentials.hidden = false; state.textContent = 'Oczekuje na weryfikację w WordPress'; state.classList.add('pending');
      window.dispatchEvent(new CustomEvent('sellio:wordpress-connected', { detail: { backendUrl: backend(), storeId: data.store_id, name: value('name'), siteUrl: value('site_url') } }));
      const catalogToken = value('catalog_token');
      if (catalogToken) {
        const catalogResponse = await fetch(`${backend()}/v1/admin/wordpress/stores/${data.store_id}/catalog/check`, { method: 'POST', headers: { 'Content-Type': 'application/json', ...authorization() }, body: JSON.stringify({ catalog_url: value('site_url'), catalog_token: catalogToken }) });
        const catalog = await catalogResponse.json(); if (!catalogResponse.ok) throw new Error(catalog.error || 'Nie udało się zweryfikować katalogu WordPress.');
      }
      feedback.textContent = catalogToken ? 'Dane dostępowe utworzone, a katalog WordPress został zweryfikowany. Token API jest widoczny tylko teraz — skopiuj go przed zamknięciem strony.' : 'Dane dostępowe utworzone. Token API jest widoczny tylko teraz — skopiuj go przed zamknięciem strony.';
    } catch (error) { feedback.textContent = error instanceof Error ? error.message : 'Wystąpił nieznany błąd.'; state.textContent = 'Błąd konfiguracji'; state.classList.add('error'); }
  });
  document.querySelector<HTMLButtonElement>('[data-copy]')!.addEventListener('click', async () => {
    const api = document.querySelector<HTMLElement>('[data-api-url]')!.textContent; const id = document.querySelector<HTMLElement>('[data-store-id]')!.textContent; const token = document.querySelector<HTMLElement>('[data-api-token]')!.textContent;
    await navigator.clipboard.writeText(`API Sellio: ${api}\nID sklepu: ${id}\nToken API: ${token}`); feedback.textContent = 'Dane skopiowane do schowka.';
  });
</script>
<script define:vars={{ supabaseUrl: import.meta.env.PUBLIC_SUPABASE_URL ?? '', supabaseKey: import.meta.env.PUBLIC_SUPABASE_PUBLISHABLE_KEY ?? '' }}>
  const storedConnectionForm = document.querySelector('[data-connect-form]');
  const storedConnectionState = document.querySelector('[data-state]');
  const getSession = () => JSON.parse(localStorage.getItem('sellio-auth-session') || 'null');
  const apiHeaders = token => ({ apikey: supabaseKey, Authorization: `Bearer ${token}`, 'Content-Type': 'application/json' });
  async function currentOrganization(token) {
    const userResponse = await fetch(`${supabaseUrl}/auth/v1/user`, { headers: apiHeaders(token) });
    if (!userResponse.ok) throw new Error('Brak aktywnej sesji.');
    const user = await userResponse.json();
    const membershipResponse = await fetch(`${supabaseUrl}/rest/v1/organization_members?user_id=eq.${encodeURIComponent(user.id)}&select=organization_id&limit=1`, { headers: apiHeaders(token) });
    const memberships = await membershipResponse.json();
    if (!membershipResponse.ok || !memberships[0]) throw new Error('Nie znaleziono firmy dla tego konta.');
    return memberships[0].organization_id;
  }
  async function saveConnection(detail) {
    const session = getSession(); if (!session?.access_token || !supabaseUrl || !supabaseKey) return;
    const organizationId = await currentOrganization(session.access_token);
    const response = await fetch(`${supabaseUrl}/rest/v1/stores?on_conflict=organization_id,provider,external_id`, { method: 'POST', headers: { ...apiHeaders(session.access_token), Prefer: 'resolution=merge-duplicates,return=minimal' }, body: JSON.stringify({ organization_id: organizationId, provider: 'woocommerce', name: detail.name, site_url: detail.siteUrl, external_id: detail.storeId, credentials: { backend_url: detail.backendUrl } }) });
    if (!response.ok) throw new Error('Nie udało się zapisać danych integracji w bazie.');
  }
  async function loadConnection() {
    const session = getSession(); if (!session?.access_token || !supabaseUrl || !supabaseKey) return;
    const organizationId = await currentOrganization(session.access_token);
    const response = await fetch(`${supabaseUrl}/rest/v1/stores?organization_id=eq.${encodeURIComponent(organizationId)}&provider=eq.woocommerce&select=name,site_url,credentials&order=updated_at.desc&limit=1`, { headers: apiHeaders(session.access_token) });
    const stores = await response.json(); if (!response.ok || !stores[0] || !storedConnectionForm) return;
    const store = stores[0];
    storedConnectionForm.elements.namedItem('name').value = store.name || '';
    storedConnectionForm.elements.namedItem('site_url').value = store.site_url || '';
    storedConnectionForm.elements.namedItem('backend_url').value = store.credentials?.backend_url || '';
    if (storedConnectionState) storedConnectionState.textContent = `Skonfigurowano: ${store.name}`;
  }
  window.addEventListener('sellio:wordpress-connected', event => saveConnection(event.detail).then(() => { if (storedConnectionState) storedConnectionState.textContent = 'Zapisano w Twojej przestrzeni'; }).catch(() => {}));
  loadConnection().catch(() => {});
</script>
