---
import Icon from './Icon.astro';
---
<section class="integration-overview" aria-labelledby="integration-overview-title">
  <div class="integration-map">
    <h2 id="integration-overview-title" class="sr-only">Mapa integracji</h2>
    <div class="integration-core">sellio<span>.</span></div>
    <div class="integration-wires" aria-hidden="true"><i></i><i></i><i></i></div>
    <div class="integration-nodes">
      <article class="integration-node allegro-node"><strong>allegro</strong><span>Marketplace</span><small data-allegro-overview-state>Sprawdzanie…</small></article>
      <article class="integration-node woo-node"><strong>woo</strong><span>WooCommerce</span><small>Główny magazyn</small></article>
    </div>
  </div>
  <div class="integration-actions"><button class="add-integration" type="button" data-scroll-to-woo><span>+</span>Dodaj integrację</button></div>
</section>
<section class="integration-settings" aria-labelledby="integration-settings-title">
  <h2 id="integration-settings-title">Ustawienia integracji</h2>
  <div class="integration-table-wrap"><table><thead><tr><th>Typ</th><th>Nazwa</th><th>Pobierane dane</th><th>Wysyłane dane</th><th><span class="sr-only">Akcje</span></th></tr></thead><tbody>
    <tr><td><span class="integration-type allegro-type"><Icon name="tag" size={14} />Allegro</span></td><td><strong data-allegro-overview-name>Połącz konto Allegro</strong></td><td><span class="sync-pill muted">—</span></td><td><span class="sync-pill muted">—</span></td><td><a class="integration-configure" href="#allegro-connection">Konfiguruj</a></td></tr>
    <tr><td><span class="integration-type woo-type"><Icon name="store" size={14} />WooCommerce</span></td><td><strong>Sklep WordPress</strong></td><td><span class="sync-pill">Produkty</span><span class="sync-pill">Ceny</span><span class="sync-pill">Stany</span></td><td><span class="sync-pill">Zamówienia</span><span class="sync-pill">Statusy</span></td><td><a class="integration-configure" href="#wordpress-setup" data-open-wordpress-setup><Icon name="settings" size={14} />Konfiguruj</a></td></tr>
  </tbody></table></div>
</section>
<script>
  const setup = document.querySelector<HTMLDialogElement>('#wordpress-setup');
  const showSetup = () => { if (setup && !setup.open) setup.showModal(); };
  document.querySelector<HTMLElement>('[data-scroll-to-woo]')?.addEventListener('click', showSetup);
  document.querySelector<HTMLElement>('[data-open-wordpress-setup]')?.addEventListener('click', event => { event.preventDefault(); showSetup(); });
</script>
