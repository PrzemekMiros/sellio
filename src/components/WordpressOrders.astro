---
const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL ?? '';
const supabaseKey = import.meta.env.PUBLIC_SUPABASE_PUBLISHABLE_KEY ?? '';
---
<section class="wordpress-orders" data-supabase-url={supabaseUrl} data-supabase-key={supabaseKey} aria-labelledby="wordpress-orders-title">
  <div><span class="eyebrow">ZAMÓWIENIA WOO COMMERCE</span><h2 id="wordpress-orders-title">Lista zamówień</h2><p>Nowe zamówienia są przekazywane automatycznie przez Sellio Connector.</p></div>
  <div class="products-toolbar"><button class="button button-primary" type="button" data-orders-refresh>Odśwież zamówienia</button><a href="/admin/integracje" class="products-integration-link">Ustawienia integracji</a></div>
  <p class="integration-feedback" role="status" data-orders-feedback></p>
  <div class="orders-result" data-orders-result hidden><p data-orders-count></p><div class="orders-table-wrap"><table><thead><tr><th>Numer</th><th>Data</th><th>Klient</th><th>Kwota</th><th>Płatność</th><th>Status</th><th>Pozycje</th></tr></thead><tbody data-orders-body></tbody></table></div></div>
</section>
<script>
  const section = document.querySelector<HTMLElement>('.wordpress-orders')!;
  const feedback = section.querySelector<HTMLElement>('[data-orders-feedback]')!;
  const result = section.querySelector<HTMLElement>('[data-orders-result]')!;
  const body = section.querySelector<HTMLTableSectionElement>('[data-orders-body]')!;
  const count = section.querySelector<HTMLElement>('[data-orders-count]')!;
  const refresh = section.querySelector<HTMLButtonElement>('[data-orders-refresh]')!;
  const supabaseUrl = section.dataset.supabaseUrl ?? '';
  const supabaseKey = section.dataset.supabaseKey ?? '';
  const session = () => JSON.parse(localStorage.getItem('sellio-auth-session') || 'null');
  const authHeaders = () => {
    const current = session(); if (!current?.access_token) throw new Error('Zaloguj się ponownie, aby pobrać zamówienia.');
    return { Authorization: `Bearer ${current.access_token}` };
  };
  const cell = (value: unknown) => { const element = document.createElement('td'); element.textContent = value === null || value === undefined || value === '' ? '—' : String(value); return element; };
  const displayDate = (value: unknown) => { if (!value) return '—'; const date = new Date(String(value)); return Number.isNaN(date.getTime()) ? String(value) : date.toLocaleString('pl-PL', { dateStyle: 'medium', timeStyle: 'short' }); };
  async function connection() {
    const current = session(); if (!current?.access_token || !supabaseUrl || !supabaseKey) return null;
    const response = await fetch(`${supabaseUrl}/rest/v1/stores?provider=eq.woocommerce&select=external_id,credentials&order=updated_at.desc&limit=1`, { headers: { apikey: supabaseKey, Authorization: `Bearer ${current.access_token}` } });
    const stores = await response.json(); const store = response.ok ? stores[0] : null;
    return store?.external_id && store.credentials?.backend_url ? { storeId: store.external_id, backendUrl: store.credentials.backend_url } : null;
  }
  function render(orders: Record<string, any>[]) {
    body.replaceChildren();
    for (const order of orders) {
      const customer = [order.billing?.first_name, order.billing?.last_name].filter(Boolean).join(' ') || order.email;
      const items = Array.isArray(order.items) ? order.items.reduce((sum: number, item: Record<string, any>) => sum + Number(item.quantity || 0), 0) : 0;
      const row = document.createElement('tr'); row.append(cell(`#${order.number || order.id}`), cell(displayDate(order.created_at)), cell(customer), cell(order.total ? `${order.total} ${order.currency || ''}`.trim() : null), cell(order.payment_method), cell(order.status), cell(items)); body.append(row);
    }
  }
  async function load() {
    result.hidden = true; feedback.textContent = 'Pobieram zamówienia…';
    try {
      const config = await connection(); if (!config) throw new Error('Najpierw skonfiguruj połączenie WooCommerce w zakładce Integracje.');
      const response = await fetch(`${String(config.backendUrl).replace(/\/$/, '')}/v1/admin/wordpress/stores/${encodeURIComponent(config.storeId)}/orders`, { headers: authHeaders() });
      const data = await response.json(); if (!response.ok) throw new Error(data.error || `Nie udało się pobrać zamówień (HTTP ${response.status}).`);
      render(data.orders); count.textContent = `Wyświetlono ${data.orders.length} z ${data.total} zamówień.`; result.hidden = false;
      feedback.textContent = data.orders.length ? '' : 'Brak odebranych zamówień. W WordPress: WooCommerce → Sellio Connector wybierz „Wyślij ostatnie 30 dni”.';
    } catch (error) { feedback.textContent = error instanceof Error ? error.message : 'Nie udało się pobrać zamówień.'; }
  }
  refresh.addEventListener('click', load); load();
</script>
