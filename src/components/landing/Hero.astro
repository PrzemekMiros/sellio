---
import ProductPreview from './ProductPreview.astro';
import Icon from '../Icon.astro';
import { site } from '../../config/site';
---

<section class="hero-section">
  <div class="hero-glow" aria-hidden="true"></div>
  <div class="hero-orbits" aria-hidden="true"><span class="hero-orbit outer"><i><Icon name="bag" size={23} /></i></span><span class="hero-orbit middle"><i><Icon name="store" size={22} /></i></span><span class="hero-orbit inner"><i><Icon name="truck" size={22} /></i></span></div>
  <div class="hero-stars" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div>
  <div class="container hero-content">
    <div class="hero-badge"><span class="hero-channel-icons">{[{ name: 'Allegro', file: 'allegro.ico' }, { name: 'eBay', file: 'ebay.ico' }, { name: 'Wordpress', file: 'wordpress.png' }, { name: 'Fakturownia', file: 'fakturownia.png' }, { name: 'Apaczka', file: 'apaczka.svg' }].map(brand => <span title={brand.name}><img src={`/brands/${brand.file}`} alt={brand.name} width="22" height="22" /></span>)}</span><span>Twoje kanały sprzedaży. Jedna przestrzeń.</span></div>
    <h1>Marketplace'y<br /><span>w jednym panelu</span></h1>
    <p class="hero-description">Panel do obsługi zamówień, ofert, stanów magazynowych i wysyłek. <br />Zobacz demonstrację interfejsu i planowany zakres funkcji</p>
    <form class="hero-actions" action={site.demoUrl} method="get" aria-label="Otwórz demo panelu">
      <label class="secondary-button hero-name-field" for="demo-name">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="4" /><path d="M4 21v-2a8 8 0 0 1 16 0v2" /></svg>
        <span class="hero-name-content"><span class="action-detail">Twoje imię</span><input id="demo-name" name="imie" type="text" autocomplete="given-name" placeholder="Wpisz swoje imię" maxlength="80" pattern=".*\S.*" required /></span>
      </label>
      <button class="button" type="submit">Zobacz demo</button>
    </form>
    <p class="hero-note">Prototyp aplikacji. Moduły i integracje są w przygotowaniu.</p>
    <div class="hero-preview"><div class="preview-caption"><Icon name="dashboard" size={15} />Podgląd demonstracyjny<span>SELLIO / PANEL SPRZEDAWCY</span></div><ProductPreview variant="dashboard" /></div>
    <div class="channel-strip"><span>PLANOWANE POŁĄCZENIA</span><strong>allegro</strong><strong><Icon name="store" size={23} />Wordpress</strong><i></i><span><Icon name="truck" size={19} />Przewoźnicy</span><span><Icon name="file" size={19} />Fakturowanie</span></div>
  </div>
</section>
