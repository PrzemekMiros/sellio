---
import Icon from '../Icon.astro';
const integrations = [{name:'Allegro', label:'MARKETPLACE', icon:'tag'}, {name:'Wordpress', label:'TWÓJ SKLEP', icon:'store'}, {name:'Przewoźnicy', label:'DOSTAWA', icon:'truck'}, {name:'Fakturowanie', label:'DOKUMENTY', icon:'file'}];
const steps = [{title:'Połącz sklep i konto Allegro', text:'Planowane integracje połączą Twoje kanały sprzedaży we wspólnej przestrzeni.', icon:'plug'}, {title:'Powiąż produkty z ofertami', text:'Przypiszesz produkty z katalogu do ofert, aby zarządzać dostępnością i cenami.', icon:'box'}, {title:'Obsługuj zamówienia i wysyłki', text:'Z jednej listy przejdziesz od nowego zamówienia do przygotowania przesyłki.', icon:'truck'}];
---
<section class="integrations-section" id="integracje"><div class="container"><div class="light-section-heading"><span class="eyebrow">TWOJE NARZĘDZIA. WSPÓLNY KIERUNEK.</span><h2>Połącz to, co już znasz.</h2><p>Planujemy integracje wokół Twojego sklepu i codziennej obsługi sprzedaży.</p></div><div class="integration-tiles">{integrations.map(item => <article><span class="integration-emblem"><Icon name={item.icon} size={30} /></span><span class="eyebrow">{item.label}</span><h3>{item.name}</h3><span class="integration-status">Planowana integracja</span></article>)}</div><div class="workflow" id="jak-to-dziala"><div class="workflow-heading"><span class="eyebrow">PLANOWANY PRZEBIEG PRACY</span><h2>Od połączenia<br />do pierwszej paczki.</h2></div><div class="workflow-steps">{steps.map(step => <article><span class="workflow-icon"><Icon name={step.icon} size={22} /></span><div><h3>{step.title}</h3><p>{step.text}</p></div></article>)}</div></div></div></section>
