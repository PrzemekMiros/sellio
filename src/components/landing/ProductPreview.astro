---
import Icon from '../Icon.astro';
interface Props { variant: 'dashboard' | 'orders' | 'inventory' | 'templates' | 'shipping' }
const { variant } = Astro.props;
const demoOrders = [{id:'DEMO-1042', channel:'Allegro', status:'Opłacone', fulfillment:'Do spakowania'}, {id:'DEMO-1041', channel:'Wordpress', status:'Opłacone', fulfillment:'Nowe'}, {id:'DEMO-1040', channel:'Allegro', status:'Oczekuje', fulfillment:'Nowe'}];
---
<div class:list={['product-preview', `preview-${variant}`]}>
  <div class="preview-bar"><span class="window-dots"><i></i><i></i><i></i></span><span>sellio / {variant === 'dashboard' ? 'pulpit' : variant === 'orders' ? 'zamówienia' : variant === 'inventory' ? 'stany i ceny' : variant === 'templates' ? 'szablony ofert' : 'wysyłki'}</span><span class="demo-tag">DEMO</span></div>
  {variant === 'dashboard' ? <div class="demo-dashboard"><aside class="demo-sidebar" aria-hidden="true"><div class="demo-brand">sellio<span>.</span></div>{[{label:'Strona główna', icon:'dashboard'}, {label:'Zamówienia', icon:'bag'}, {label:'Produkty', icon:'box'}, {label:'Analityka', icon:'chart'}, {label:'Integracje', icon:'plug'}].map((item, i) => <div class:list={['demo-nav-item', { selected: i === 0 }]}><Icon name={item.icon} size={16} /><span>{item.label}</span></div>)}<div class="demo-nav-caption">MARKETPLACE</div><div class="demo-nav-item"><Icon name="tag" size={16} />Allegro</div><div class="demo-profile"><span>M</span>Moja przestrzeń</div></aside><div class="demo-workspace"><div class="demo-heading"><div><span class="micro-label">TWOJE CENTRUM SPRZEDAŻY</span><h3>Wszystko pod kontrolą<span class="orange">.</span></h3></div><span class="demo-subtle">Podgląd demonstracyjny</span></div><div class="demo-welcome"><Icon name="plug" size={24} /><div><strong>Twoja sprzedaż w jednym miejscu.</strong><p>Allegro i Wordpress. Jedna przestrzeń do pracy.</p></div><span class="demo-status">W przygotowaniu</span></div><div class="demo-kpis">{[{name:'Nowe zamówienia', icon:'bag'}, {name:'Do wysłania', icon:'truck'}, {name:'Błędy synchronizacji', icon:'activity'}].map(item => <div><span>{item.name}<Icon name={item.icon} size={17} /></span><strong>—</strong><small>Oczekiwanie na dane</small></div>)}</div><div class="demo-orders-block"><div class="demo-section-title">Ostatnie zamówienia <span>0</span></div><div class="demo-empty"><Icon name="inbox" size={30} /><strong>Tu pojawią się Twoje zamówienia</strong><p>Zamówienia pojawią się po uruchomieniu integracji</p></div></div><div class="demo-bottom-note"><Icon name="shield" size={13} />Podgląd interfejsu · bez połączeń z API</div></div></div>
  : variant === 'orders' ? <div class="fragment-body"><div class="fragment-title"><h3>Lista zamówień</h3><span class="demo-status">Dane demonstracyjne</span></div><div class="feature-overview" aria-label="Podsumowanie danych demonstracyjnych"><div><strong class="overview-ring">3</strong><small>Zamówienia demo</small></div><div><strong>2</strong><small>Opłacone</small></div><div><strong>1</strong><small>Oczekuje na płatność</small></div></div><div class="fake-tabs"><span class="selected">Wszystkie <b>3</b></span><span>Do spakowania</span><span>Nowe</span></div><div class="demo-table" role="table" aria-label="Przykładowe zamówienia — dane demonstracyjne"><div class="table-row table-head" role="row"><span role="columnheader">Zamówienie</span><span role="columnheader">Płatność</span><span role="columnheader">Realizacja</span></div>{demoOrders.map(order => <div class="table-row" role="row"><div role="cell"><strong>{order.id}</strong><small>{order.channel}</small></div><span class="payment" role="cell">{order.status}</span><span class="fulfillment" role="cell">{order.fulfillment}</span></div>)}</div><div class="fragment-footer"><Icon name="bag" size={15} />Dwa kanały. Wspólny widok zamówień.</div></div>
  : variant === 'inventory' ? <div class="fragment-body"><div class="fragment-title"><h3>Powiązanie produktu</h3><span class="demo-status">Dane demonstracyjne</span></div><div class="product-identity"><span class="product-thumb"><Icon name="box" size={29} /></span><div><strong>Plecak miejski · grafitowy</strong><small>SKU: DEMO-BAG-01</small></div></div><div class="sync-connection"><div><span class="channel-symbol">W</span><strong>Wordpress</strong><small>Produkt w sklepie</small></div><span class="sync-wire"><Icon name="sliders" size={21} /></span><div><span class="channel-symbol">a</span><strong>Allegro</strong><small>Powiązana oferta</small></div></div><div class="inventory-values"><div><span>Dostępność</span><strong>24 <small>szt.</small></strong></div><div><span>Cena sprzedaży</span><strong>149,00 <small>zł</small></strong></div></div><div class="fragment-footer"><span class="status-dot"></span>Przykładowy status: zsynchronizowano</div></div>
  : variant === 'templates' ? <div class="fragment-body"><div class="fragment-title"><h3>Szablon oferty</h3><span class="demo-status">Statyczny podgląd</span></div><div class="template-category"><Icon name="tag" size={14} />Kategoria: Plecaki i torby</div><div class="template-editor"><div class="template-tools"><span class="selected"><Icon name="file" size={17} />Tekst</span><span><Icon name="layout" size={17} />Zdjęcie</span><span><Icon name="box" size={17} />Produkt</span></div><div class="template-canvas"><div class="template-image"><Icon name="bag" size={55} /><span>Miejsce na zdjęcie produktu</span></div><div class="template-copy"><span class="micro-label">TWÓJ PRODUKT</span><strong>Gotowy na każdy dzień.</strong><div class="skeleton-line"></div><div class="skeleton-line short"></div><div class="template-feature"><Icon name="check" size={14} />Opis i najważniejsze cechy</div></div></div></div><div class="fragment-footer"><Icon name="layout" size={15} />Jeden szablon. Spójne opisy ofert.</div></div>
  : <div class="fragment-body"><div class="fragment-title"><h3>Przesyłka DEMO-1042</h3><span class="demo-status">Dane demonstracyjne</span></div><div class="shipment-path"><span><Icon name="bag" size={19} />Zamówienie</span><i></i><span><Icon name="box" size={19} />Pakowanie</span><i></i><span class="selected"><Icon name="truck" size={19} />Nadanie</span></div><div class="shipping-label"><div><span class="micro-label">ETYKIETA PRZESYŁKI</span><strong>Paczka standardowa</strong><span class="label-status"><Icon name="file" size={14} />Przykładowy status: gotowa</span></div><Icon name="box" size={43} /></div><div class="tracking"><span>Numer śledzenia · przykład</span><strong>DEMO-0000-1042</strong><div class="barcode" aria-hidden="true"></div></div><div class="fragment-footer"><Icon name="info" size={15} />Podgląd — etykieta nie jest dokumentem nadania.</div></div>}
</div>
