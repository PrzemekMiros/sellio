---
import '../styles/auth.css';
---
<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Zaloguj się lub utwórz konto Sellio." />
    <title>Zaloguj się · Sellio</title>
    <link rel="icon" href="/landing-favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <main class="auth-page">
      <a class="auth-brand" href="/" aria-label="Sellio — strona główna"><span>s</span>sellio<i>.</i></a>
      <section class="auth-card" aria-labelledby="auth-title">
        <div class="auth-tabs" role="tablist" aria-label="Wybierz rodzaj formularza">
          <button type="button" class="is-active" role="tab" aria-selected="true" aria-controls="login-panel" data-auth-tab="login">Logowanie</button>
          <button type="button" role="tab" aria-selected="false" aria-controls="register-panel" data-auth-tab="register">Załóż konto</button>
        </div>
        <div id="login-panel" role="tabpanel" data-auth-panel="login">
          <div class="auth-heading"><p>WITAJ PONOWNIE</p><h1 id="auth-title">Zaloguj się do Sellio</h1><span>Wejdź do swojego centrum sprzedaży.</span></div>
          <button class="google-button" type="button" data-google><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="#4285F4" d="M21.8 12.2c0-.7-.1-1.4-.2-2H12v3.8h5.5a4.7 4.7 0 0 1-2 3.1v2.5h3.2c1.9-1.8 3.1-4.4 3.1-7.4Z"/><path fill="#34A853" d="M12 22c2.7 0 5-.9 6.7-2.4l-3.2-2.5c-.9.6-2 .9-3.5.9-2.7 0-5-1.8-5.8-4.3H2.9v2.6A10 10 0 0 0 12 22Z"/><path fill="#FBBC05" d="M6.2 13.7A6 6 0 0 1 5.9 12c0-.6.1-1.1.3-1.7V7.7H2.9A10 10 0 0 0 2 12c0 1.6.4 3.1.9 4.3l3.3-2.6Z"/><path fill="#EA4335" d="M12 6c1.5 0 2.8.5 3.8 1.5l2.8-2.8A10 10 0 0 0 2.9 7.7l3.3 2.6C7 7.8 9.3 6 12 6Z"/></svg>Kontynuuj z Google</button>
          <div class="auth-divider"><span>lub użyj adresu e-mail</span></div>
          <form class="auth-form" data-auth-form data-mode="login"><label>Adres e-mail<input type="email" name="email" autocomplete="email" placeholder="ty@firma.pl" required /></label><label>Hasło<input type="password" name="password" autocomplete="current-password" placeholder="Wpisz hasło" required minlength="8" /></label><a class="forgot-link" href="#reset">Nie pamiętasz hasła?</a><button class="auth-submit" type="submit">Zaloguj się</button></form>
        </div>
        <div id="register-panel" role="tabpanel" data-auth-panel="register" hidden>
          <div class="auth-heading"><p>ZACZNIJ ZA DARMO</p><h1>Załóż konto Sellio</h1><span>Stwórz przestrzeń dla swojej sprzedaży.</span></div>
          <button class="google-button" type="button" data-google><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="#4285F4" d="M21.8 12.2c0-.7-.1-1.4-.2-2H12v3.8h5.5a4.7 4.7 0 0 1-2 3.1v2.5h3.2c1.9-1.8 3.1-4.4 3.1-7.4Z"/><path fill="#34A853" d="M12 22c2.7 0 5-.9 6.7-2.4l-3.2-2.5c-.9.6-2 .9-3.5.9-2.7 0-5-1.8-5.8-4.3H2.9v2.6A10 10 0 0 0 12 22Z"/><path fill="#FBBC05" d="M6.2 13.7A6 6 0 0 1 5.9 12c0-.6.1-1.1.3-1.7V7.7H2.9A10 10 0 0 0 2 12c0 1.6.4 3.1.9 4.3l3.3-2.6Z"/><path fill="#EA4335" d="M12 6c1.5 0 2.8.5 3.8 1.5l2.8-2.8A10 10 0 0 0 2.9 7.7l3.3 2.6C7 7.8 9.3 6 12 6Z"/></svg>Zarejestruj się przez Google</button>
          <div class="auth-divider"><span>lub użyj adresu e-mail</span></div>
          <form class="auth-form" data-auth-form data-mode="register"><label>Adres e-mail<input type="email" name="email" autocomplete="email" placeholder="ty@firma.pl" required /></label><label>Hasło<input type="password" name="password" autocomplete="new-password" placeholder="Minimum 8 znaków" required minlength="8" /></label><label class="auth-check"><input type="checkbox" required /> <span>Akceptuję regulamin i politykę prywatności.</span></label><button class="auth-submit" type="submit">Załóż konto</button></form>
        </div>
        <p class="auth-feedback" role="status" data-auth-feedback></p>
      </section>
      <p class="auth-back"><a href="/">← Wróć na stronę główną</a></p>
    </main>
    <script>
      const tabs = document.querySelectorAll<HTMLButtonElement>('[data-auth-tab]');
      const panels = document.querySelectorAll<HTMLElement>('[data-auth-panel]');
      const feedback = document.querySelector<HTMLElement>('[data-auth-feedback]')!;
      tabs.forEach(tab => tab.addEventListener('click', () => { const mode = tab.dataset.authTab; tabs.forEach(item => { const active = item === tab; item.classList.toggle('is-active', active); item.setAttribute('aria-selected', String(active)); }); panels.forEach(panel => panel.hidden = panel.dataset.authPanel !== mode); feedback.textContent = ''; }));
      document.querySelectorAll<HTMLFormElement>('[data-auth-form]').forEach(form => form.addEventListener('submit', event => { event.preventDefault(); if (!form.reportValidity()) return; feedback.textContent = form.dataset.mode === 'register' ? 'Konto zostanie utworzone po podłączeniu usługi uwierzytelniania.' : 'Logowanie będzie dostępne po podłączeniu usługi uwierzytelniania.'; }));
      document.querySelectorAll<HTMLButtonElement>('[data-google]').forEach(button => button.addEventListener('click', () => { feedback.textContent = 'Logowanie przez Google wymaga konfiguracji OAuth.'; }));
    </script>
  </body>
</html>
