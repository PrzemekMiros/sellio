---
import AdminLayout from '../../layouts/AdminLayout.astro';
import ModulePage from '../../components/ModulePage.astro';
import Icon from '../../components/Icon.astro';
import { modules } from '../../config/modules';
export function getStaticPaths() { return modules.map(module => ({ params: { slug: module.slug || undefined }, props: { module } })); }
const { module } = Astro.props;
const metrics = [{ name: 'Nowe zamówienia', icon: 'bag', detail: 'Zamówienia czekające na obsługę' }, { name: 'Do wysłania', icon: 'truck', detail: 'Przesyłki oczekujące na nadanie' }, { name: 'Błędy synchronizacji', icon: 'activity', detail: 'Zdarzenia wymagające uwagi' }];
---
<AdminLayout module={module}>
{module.slug ? <ModulePage module={module} /> : <>
  <div class="page-heading"><div><p class="eyebrow">TWOJE CENTRUM SPRZEDAŻY</p><h1>Wszystko pod kontrolą<span class="heading-dot">.</span></h1><p>Dobry dzień zaczyna się od przejrzystego pulpitu.</p></div><span class="overview-label"><Icon name="dashboard" size={16} />Przegląd sprzedaży</span></div>
  <section class="welcome-banner"><div class="welcome-content"><span class="banner-kicker">MNIEJ PRZEŁĄCZANIA. WIĘCEJ MOŻLIWOŚCI.</span><h2>Twoja sprzedaż w jednym miejscu.</h2><p>Zamówienia, produkty i wysyłki z Allegro i Wordpress. <br />Tutaj zaczyna się sprawniejsza obsługa Twojego sklepu.</p><a class="primary-link" href="/admin/integracje"><Icon name="plug" size={17} />Przejdź do integracji</a><span class="banner-note">Integracje są w przygotowaniu</span></div><div class="connection-art" aria-hidden="true"><span class="connection-line line-one"></span><span class="connection-line line-two"></span><span class="connection-line line-three"></span><div class="art-tile tile-store"><Icon name="store" size={29} /></div><div class="art-tile tile-center"><span class="art-brand">s.</span></div><div class="art-tile tile-bag"><Icon name="bag" size={28} /></div><div class="art-tile tile-box"><Icon name="box" size={30} /></div><span class="art-spark spark-one">+</span><span class="art-spark spark-two">+</span><span class="art-ring"></span></div></section>
  <section class="metrics-grid" aria-label="Podsumowanie sprzedaży">{metrics.map(metric => <article class="metric-card"><div class="metric-top"><h2>{metric.name}</h2><span class="metric-icon"><Icon name={metric.icon} /></span></div><p class="metric-value" aria-label="Brak danych">—</p><p class="metric-detail">{metric.detail}</p><div class="metric-bottom"><span class="data-dot"></span>Oczekiwanie na dane</div></article>)}</section>
  <div class="dashboard-bottom"><section class="orders-panel"><div class="panel-heading"><div><h2>Ostatnie zamówienia</h2><p>Najnowsza aktywność w Twoich kanałach sprzedaży</p></div><span class="count-badge">0</span></div><div class="empty-orders"><div class="empty-illustration"><Icon name="inbox" size={37} /><span><Icon name="bag" size={16} /></span></div><h3>Tu pojawią się Twoje zamówienia</h3><p>Zamówienia pojawią się po uruchomieniu integracji</p><a class="text-link" href="/admin/integracje">Przejdź do integracji</a></div><div class="panel-footer"><Icon name="info" size={15} />Dane z wszystkich kanałów w jednym widoku</div></section>
  <aside class="getting-started"><span class="section-kicker">PIERWSZE KROKI</span><h2>Dobre miejsce na start</h2><p>Poznaj swoją nową przestrzeń do zarządzania sprzedażą.</p><div class="start-step"><span class="step-icon"><Icon name="dashboard" size={18} /></span><div><h3>Poznaj pulpit</h3><p>Najważniejsze informacje zawsze pod ręką.</p><span class="ready-label"><Icon name="check" size={13} />Jesteś tutaj</span></div></div><div class="start-step"><span class="step-icon muted"><Icon name="plug" size={18} /></span><div><h3>Połącz kanały sprzedaży</h3><p>Allegro i Wordpress w jednej przestrzeni.</p><span class="soon-label">W przygotowaniu</span></div></div><div class="start-step"><span class="step-icon muted"><Icon name="bolt" size={18} /></span><div><h3>Uprość codzienną pracę</h3><p>Zamówienia, wysyłki i automatyzacje.</p><span class="soon-label">W przygotowaniu</span></div></div><div class="preview-note"><Icon name="shield" size={19} /><p>To podgląd Twojego panelu.<br />Dane pojawią się po uruchomieniu integracji.</p></div></aside></div>
</>}
</AdminLayout>

