---
import '../styles/global.css';
import '../styles/admin-theme.css';
import '../styles/admin-light.css';
import ThemeToggle from '../components/ThemeToggle.astro';
import AccountMenu from '../components/AccountMenu.astro';
import LoadingIndicator from '../components/LoadingIndicator.astro';
import Icon from '../components/Icon.astro';
import { type Module } from '../config/modules';
import SidebarNav from '../components/SidebarNav.astro';
interface Props { module: Module; }
const { module } = Astro.props;
---
<!doctype html>
<html lang="pl" data-theme="light">
  <head><meta charset="UTF-8" />
    <script is:inline>
      try { document.documentElement.dataset.theme = localStorage.getItem('sellio-admin-theme') === 'dark' ? 'dark' : 'light'; } catch {}
    </script>
    <meta name="viewport" content="width=device-width" /><meta name="description" content="Sellio — panel obsługi sprzedaży e-commerce. Prototyp aplikacji." /><title>{module.name} · Sellio</title><link rel="icon" type="image/svg+xml" href="/favicon.svg" /></head>
  <body>
    <LoadingIndicator />
    <a class="skip-link" href="#main">Przejdź do treści</a>
    <div class="sidebar-overlay" id="sidebar-overlay" hidden></div>
    <aside class="sidebar" id="sidebar" aria-label="Menu panelu">
      <div class="brand-row"><a href="/admin" class="brand" aria-label="Sellio — pulpit"><span class="brand-symbol">s<span></span></span>sellio<span class="brand-dot">.</span></a><button class="icon-button mobile-only" id="menu-close" aria-label="Zamknij menu"><Icon name="close" /></button></div>
      <div class="workspace"><span class="workspace-icon"><Icon name="store" /></span><div><strong>Moja przestrzeń</strong><span>Panel sprzedawcy</span></div><span class="workspace-initial">M</span></div>
      <SidebarNav module={module} />
      <div class="sidebar-bottom"><span class="avatar">M</span><div><strong>Moja firma</strong><span>Przestrzeń robocza</span></div><span class="version">v0.1</span></div>
    </aside>
    <div class="page-shell">
      <header class="topbar"><div class="breadcrumbs"><button class="icon-button mobile-only" id="menu-open" aria-label="Otwórz menu" aria-controls="sidebar" aria-expanded="false"><Icon name="menu" /></button><span class="breadcrumb-parent">Przestrzeń robocza</span><span class="breadcrumb-separator">/</span><span>{module.name}</span></div><div class="topbar-right"><span class="prototype-badge"><span></span>Wersja demonstracyjna</span><ThemeToggle /><span class="topbar-divider"></span><span class="topbar-user-name" data-user-name>Moja przestrzeń</span><AccountMenu /></div></header>
      <main id="main" tabindex="-1"><slot /></main>
      <footer class="page-footer"><span>© {new Date().getFullYear()} Sellio</span><span>Twoja sprzedaż. Jedno miejsce.</span><span>Prototyp aplikacji <span class="footer-dot">·</span> v0.1</span></footer>
    </div>
    <script>
      const sidebar = document.querySelector<HTMLElement>('#sidebar')!;
      const opener = document.querySelector<HTMLButtonElement>('#menu-open')!;
      const closer = document.querySelector<HTMLButtonElement>('#menu-close')!;
      const overlay = document.querySelector<HTMLElement>('#sidebar-overlay')!;
      const shell = document.querySelector<HTMLElement>('.page-shell')!;
      const mobile = window.matchMedia('(max-width: 900px)');
      let open = false;
      function toggleMenu(next: boolean, restoreFocus = true) {
        open = next;
        sidebar.classList.toggle('is-open', next);
        opener.setAttribute('aria-expanded', String(next));
        overlay.hidden = !next;
        document.body.classList.toggle('menu-is-open', next);
        shell.inert = next;
        sidebar.inert = mobile.matches && !next;
        if (next) closer.focus();
        else if (restoreFocus) opener.focus();
      }
      opener.addEventListener('click', () => toggleMenu(true));
      closer.addEventListener('click', () => toggleMenu(false));
      overlay.addEventListener('click', () => toggleMenu(false));
      sidebar.querySelectorAll('a').forEach(link => link.addEventListener('click', () => { if (open) toggleMenu(false, false); }));
      document.addEventListener('keydown', event => {
        if (!open) return;
        if (event.key === 'Escape') toggleMenu(false);
        if (event.key === 'Tab') {
          const elements = Array.from(sidebar.querySelectorAll<HTMLElement>('a, button, summary')).filter(el => el.checkVisibility());
          const first = elements[0], last = elements[elements.length - 1];
          if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last.focus(); }
          else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first.focus(); }
        }
      });
      mobile.addEventListener('change', () => toggleMenu(false, false));
      sidebar.inert = mobile.matches;
    </script>
    <script>
      import { authClient, isLocalPreview, supabaseUrl, supabaseKey } from '../lib/auth';
      const avatar = document.querySelector<HTMLElement>('[data-user-avatar]');
      const nameTarget = document.querySelector<HTMLElement>('[data-user-name]');
      async function loadAccount() {
        if (isLocalPreview()) {
          if (nameTarget) nameTarget.textContent = 'Podgląd lokalny';
          if (avatar) { avatar.textContent = 'DEV'; avatar.setAttribute('aria-label', 'Podgląd lokalny'); }
          const badge = document.querySelector<HTMLElement>('.prototype-badge');
          if (badge) { badge.textContent = 'Tryb lokalny · dane testowe'; badge.title = 'Zmiany nie są wysyłane na produkcję.'; }
          return;
        }
        if (!supabaseUrl || !supabaseKey) { location.replace('/logowanie'); return; }
        const client = authClient();
        const { data, error } = await client.auth.getSession();
        if (error) throw error;
        if (!data.session) { location.replace('/logowanie'); return; }
        const { data: account, error: accountError } = await client.auth.getUser();
        if (accountError || !account.user || !avatar || !nameTarget) return;
        const user = account.user;
        const metadata = user.user_metadata || {};
        const name: string = metadata.full_name || [metadata.given_name, metadata.family_name].filter(Boolean).join(' ') || user.email || 'Moja przestrzeń';
        nameTarget.textContent = name; avatar.setAttribute('aria-label', name);
        avatar.textContent = name.trim().split(/\s+/).slice(0, 2).map(part => part[0]).join('').toUpperCase() || 'M';
        if (metadata.avatar_url || metadata.picture) { const image = document.createElement('img'); image.src = metadata.avatar_url || metadata.picture; image.alt = ''; image.referrerPolicy = 'no-referrer'; avatar.replaceChildren(image); }
      }
      loadAccount().catch(() => { if (nameTarget) nameTarget.textContent = 'Nie udało się odnowić sesji. Odśwież stronę.'; });
    </script>
  </body>
</html>
